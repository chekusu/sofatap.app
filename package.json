{
  "name": "sofatap-website",
  "version": "0.1.0",
  "private": true,
  "description": "Sofatap public website: a dependency-free static site in twelve languages with an interactive phone-to-TV simulation.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "release:refresh": "node scripts/refresh-releases.mjs",
    "build:publish": "node scripts/refresh-releases.mjs && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm test && npm run check",
    "preview": "node scripts/serve.mjs",
    "deploy:prepare": "node scripts/prepare-deploy.mjs"
  }
}
